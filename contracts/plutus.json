    "stellar_vault/types/EscrowDatum": {
      "title": "EscrowDatum",
      "description": "Core datum and redeemer types for the StellarVault milestone escrow.\n\n The datum is intentionally minimal: only the three parties and the\n numbers needed to authorize a spend live on-chain. Anything about\n *why* a milestone was approved (scope, deliverables, messages) stays\n off-chain — the validator only ever needs to know *who* can move\n funds and *under what condition*.\n One escrow covers a single milestone payment between a buyer and a\n seller, with an arbiter who can only act as a tie-breaker.",
      "anyOf": [
        {
          "title": "EscrowDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "buyer",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "seller",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "arbiter",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "milestone_amount",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "deadline",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "stellar_vault/types/EscrowRedeemer": {
      "title": "EscrowRedeemer",
      "description": "The ways funds locked in an escrow UTxO can move.",
      "anyOf": [
        {
          "title": "Release",
          "description": "Buyer signs off that the milestone was delivered; seller is paid.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "Refund",
          "description": "Buyer reclaims funds once the deadline has passed with no release.",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        },
        {
          "title": "Cancel",
          "description": "Seller consents to cancel and refunds the buyer early before deadline.",
          "dataType": "constructor",
          "index": 2,
          "fields": []
        },
        {
          "title": "Resolve",
          "description": "Arbiter breaks a deadlock and directs funds to one side.",
          "dataType": "constructor",
